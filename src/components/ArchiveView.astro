---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import WorkCard from '@/components/WorkCard.astro';
import { t, type Locale } from '@/i18n';
import { archiveOnly } from '@/lib/validate';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const all = (await getCollection('work')).map((e) => e.data);
const items = archiveOnly(all);
---

<Base locale={locale} title={t(locale, 'archive.title')}>
  <Nav locale={locale} />
  <main>
    <h1>{t(locale, 'archive.title')}</h1>
    <section class="work-grid">
      {items.length > 0
        ? items.map((entry) => <WorkCard entry={entry} locale={locale} />)
        : <p class="mono">{t(locale, 'archive.empty')}</p>}
    </section>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  main {
    padding: var(--section-gap-mobile) var(--grid-margin) 0;
  }

  .work-grid {
    display: grid;
    gap: var(--grid-gutter);
    padding: var(--space-8) 0 var(--section-gap-mobile);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
