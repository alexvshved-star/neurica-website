---
import { Picture } from 'astro:assets';
import { type Locale } from '@/i18n';
import { renderableStatus } from '@/lib/validate';
import type { WorkEntry } from '@/content.config';

// Клітинка сітки 2×2 на головній (design-brief "hero+grid", крок
// hero-тільки-текст): --image-ratio свідомо не діє тут — усі
// клітинки 1/1 незалежно від art_direction (докладніше —
// docs/02-design-system.md, «Стрічка головної»). Окремий компонент,
// не WorkCard: WorkCard лишається для /archive (compact), його
// не-компактний режим більше нізвідки не викликається — свідомо
// не видалений, див. звіт кроку.
//
// Крок "композиція сітки": підпис рендериться ЯК ОКРЕМИЙ grid-item,
// не всередині обгортки зображення — інакше висота підпису
// потрапляє в розмір grid-рядка з фото (рядки сітки просідають,
// вертикальний gap візуально розбухає до gap+caption). index задає
// явні grid-column/grid-row для обох частин (HomeView.astro,
// .feed__grid: grid-template-columns: repeat(2,1fr), image-рядок і
// caption-рядок ідуть парами — 1,2 фото / 3,4 підписи / 5,6 фото...).

interface Props {
  entry: WorkEntry;
  locale: Locale;
  index: number;
  total: number;
  priority?: boolean;
}

const { entry, locale, index, total, priority = false } = Astro.props;
const translation = entry.translations[locale];
if (!translation) {
  throw new Error(`HomeGridCell: ${entry.slug} не має перекладу для ${locale} (мало впасти на 5.7 раніше)`);
}

const href = locale === 'uk' ? `/work/${entry.slug}` : `/en/work/${entry.slug}`;
const status = renderableStatus(entry.status);
const statusClass = entry.status === 'LIVE'
  ? 'meta--live'
  : entry.status === 'FROZEN' || entry.status === 'ARCHIVE'
    ? 'meta--frozen'
    : 'meta--status';

// object-position покадрово, не однаково (design-brief п.2): де кроп
// справді відбувається (портретна ORGANIC у квадратній клітинці),
// позиція підібрана під сюжет конкретного кадру — see docs/05-
// decisions.md. altaco-catalog (MATERIAL) уже нативно 1:1, кропу
// нема, тому без запису тут нічого не змінює. Заглушки — тимчасові,
// без спеціального значення.
const COVER_POSITION: Partial<Record<string, string>> = {
  'what-neurica-is': '50% 25%',
};
const cellPosition = COVER_POSITION[entry.slug] ?? '50% 50%';

// column: 1 або 2. imageRow/captionRow: пара рядків на "ряд" сітки
// (2 клітинки на ряд), фото завжди в непарному, підпис — у
// наступному парному.
const column = (index % 2) + 1;
const pairIndex = Math.floor(index / 2);
const imageRow = pairIndex * 2 + 1;
const captionRow = imageRow + 1;

// Останній ряд не отримує нижній відступ (design-brief п.2): це той
// самий gap-принцип, що й CSS row-gap — простір МІЖ рядами, не після
// останнього.
const totalPairs = Math.ceil(total / 2);
const isLastRow = pairIndex === totalPairs - 1;
---

<a
  class="grid-cell__link"
  style={`--cell-col:${column}; --cell-row:${imageRow};`}
  href={href}
  data-direction={entry.art_direction.toLowerCase()}
>
  <Picture
    class="grid-cell__cover"
    src={entry.cover}
    alt=""
    formats={['avif', 'webp']}
    widths={[400, 800]}
    sizes="(min-width: 769px) 280px, 46vw"
    loading={priority ? 'eager' : 'lazy'}
    style={`--cell-position: ${cellPosition}`}
  />
</a>
<div
  class="grid-cell__caption"
  class:list={{ 'grid-cell__caption--last-row': isLastRow }}
  style={`--cell-col:${column}; --cell-row:${captionRow};`}
>
  <p class="meta grid-cell__type">
    {entry.type.replace('_', ' ')}{status && <span class={`meta ${statusClass}`}> · {status}</span>}
  </p>
  <h2 class="grid-cell__title">{translation.title}</h2>
</div>

<style>
  /* min-width:0 — без цього track 1fr бере свій мінімум від
     min-content дитини (тут: нерозривний текст заголовка), і дві
     колонки виходять різної ширини (виявлено реальним виміром:
     360px проти 358px). Той самий клас багів, що text-overflow у
     flex-дитині (WorkIndexRow.astro) — тут grid-версія. */
  .grid-cell__link,
  .grid-cell__caption {
    min-width: 0;
  }

  .grid-cell__link {
    display: block;
    color: var(--color-text);
    text-decoration: none;
  }

  /* aspect-ratio:1/1 фіксовано (design-brief п.4) — --image-ratio
     свідомо не застосований тут, на відміну від сторінки об'єкта
     (WorkDetailView.astro) і раніше стрічки (тепер /work). */
  .grid-cell__link :global(.grid-cell__cover) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: var(--cell-position, 50% 50%);
    filter: var(--image-filter, none);
  }

  /* Підпис — етикетка під експонатом (design-brief крок "пропорції й
     типографіка підписів"), не проза між рядами: margin-top малий
     (14px, від низу кадру до TYPE), margin-bottom великий (55px,
     "row-gap" до наступного ряду — зменшено з 85px, крок "зменшити
     row-gap") — CSS Grid row-gap не може дати різні значення для
     двох різних меж (фото→підпис і підпис→наступне фото), тому
     вертикальний ритм керується тут margin'ами, а не властивістю
     gap на .feed__grid (там лишається лише column-gap,
     HomeView.astro). Останній ряд — без margin-bottom, той самий
     принцип, що й у справжнього gap: простір МІЖ рядами, не після
     останнього. */
  .grid-cell__caption {
    text-align: center;
    margin-top: 14px;
    margin-bottom: 55px;
  }

  .grid-cell__caption--last-row {
    margin-bottom: 0;
  }

  .grid-cell__type {
    margin-bottom: var(--space-1);
  }

  /* Виняток із правила двох регістрів (docs/02-design-system.md,
     «Два регістри»), звужений і задокументований, не мовчазний:
     підпис клітинки сітки читається як етикетка експоната, тому
     заголовок теж mono, а не Montserrat — тільки тут, ніде більше
     (сторінка об'єкта, /work, H1 — Montserrat, як і раніше).
     Розрядка менша за TYPE (--tracking-label 0.14em) — 0.08em, щоб
     заголовок не читався як ще один рядок метаданих того самого
     регістру ваги. min-height — резерв під два рядки, однаковий для
     всіх чотирьох підписів незалежно від рядка сітки (той самий
     принцип, що був для Montserrat-варіанту, перерахований під нову
     гарнітуру/кегль: перевірено реальним рендером на найдовшому
     заголовку, docs/05-decisions.md). */
  .grid-cell__title {
    font-family: var(--font-mono);
    font-weight: var(--weight-bold);
    font-size: 0.8125rem;
    line-height: 1.35;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    min-height: calc(0.8125rem * 1.35 * 2);
  }
</style>
