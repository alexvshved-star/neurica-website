---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import HomeGridCell from '@/components/HomeGridCell.astro';
import { brandDescriptor, t, type Locale } from '@/i18n';
import { excludeArchive, selectHomeFeed, warnArtDirectionRepeats } from '@/lib/validate';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const all = (await getCollection('work')).map((e) => e.data);
const items = selectHomeFeed(excludeArchive(all));
warnArtDirectionRepeats(items, `home/${locale}`);

const workHref = locale === 'uk' ? '/work' : '/en/work';
---

<Base locale={locale} title="NEURICA" description={brandDescriptor}>
  <Nav locale={locale} />
  <main>
    <div class="page-column">
      <header class="hero">
        <h1 class="type-display hero__wordmark">NEURICA</h1>
        <p class="hero__eyebrow">experiments</p>
        <p class="hero__descriptor">{brandDescriptor}</p>
      </header>
      <section class="feed__grid">
        {items.map((entry, i) => <HomeGridCell entry={entry} locale={locale} index={i} priority={i === 0} />)}
      </section>
    </div>
    <a class="feed__view-all mono" href={workHref}>{t(locale, 'work.viewAll')} →</a>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  /* Крок "композиція сітки": один спільний контейнер фіксованої
     ширини для hero і сітки (design-brief п.4-5) — раніше кожен мав
     власний max-width (900px / 720px) і власний margin-inline:auto,
     що математично центрувалось навколо того самого середника
     сторінки, але читалось як дві різні колонки. Тепер обидва —
     прямі діти ЦЬОГО контейнера, без власної ширини. 660px —
     design-brief п.5: дві клітинки по 325px + gap 10px. */
  .page-column {
    width: min(660px, 92vw);
    margin-inline: auto;
    padding: var(--section-gap) 0;
    text-align: center;
  }

  /* --type-display — фіксоване значення, не clamp зі шкалою vw
     (крок "композиція сітки"): контейнер (.page-column) сам більше
     не росте з viewport понад 660px (min(660px, 92vw) — на 768px
     92vw уже 706px, стеля 660px спрацьовує вже тут), тому й розміру
     рости нема з чого — той самий 660px для 768/1440/1680.
     7rem=112px виміряно реальним рендером (Range.getClientRects()
     на текстовому вузлі, Playwright): NEURICA — 605px в 1 рядок,
     запас ≈55px до 660px колонки; перенос на два рядки настає вже
     на 124px. Мобільна шкала (≤768px, tokens.css :root) не
     чіпається. */
  @media (min-width: 768px) {
    .hero {
      --type-display: 7rem;
    }
  }

  .hero__wordmark {
    letter-spacing: var(--tracking-wordmark);
  }

  /* Другий рівень лок-апа — той самий рецепт, що й раніше (рішення
     032): кегль і базова лінія прив'язані до --type-display,
     масштабуються разом на будь-якому брейкпойнті. */
  .hero__eyebrow {
    margin-top: calc(var(--type-display) * 0.151);
    font-weight: var(--weight-strong);
    font-size: calc(var(--type-display) * 0.44);
    line-height: 1;
    letter-spacing: 0.26em;
    text-transform: lowercase;
  }

  .hero__descriptor {
    margin-top: var(--space-4);
    font-weight: var(--weight-lead);
    font-size: var(--type-lead);
    color: var(--color-muted);
  }

  /* Сітка 2×2 (design-brief п.1-2) — gap однаковий по обох осях
     (10px, design-brief п.2: раніше 4px між колонками проти 68px
     між рядками — різниця йшла від підпису всередині grid-item,
     виправлено в HomeGridCell.astro: підпис — окремий grid-item у
     власному рядку). grid-column/grid-row — з --cell-col/--cell-row
     (custom properties, встановлені інлайново в HomeGridCell.astro
     за index), не задані напряму інлайн-стилем: так медіа-запит
     нижче може перевизначити їх для мобільного без !important
     (inline style мав би вищий пріоритет за звичайне правило). */
  .feed__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: var(--section-gap);
  }

  .feed__grid :global(.grid-cell__link),
  .feed__grid :global(.grid-cell__caption) {
    grid-column: var(--cell-col, 1);
    grid-row: var(--cell-row, auto);
  }

  /* Мобільний: один стовпчик (design-brief п.3), клітинки лишаються
     КВАДРАТНИМИ — aspect-ratio:1/1 на .grid-cell__cover
     (HomeGridCell.astro) не залежить від кількості колонок. Явне
     розміщення знято (grid-column:1, grid-row:auto) — при одній
     колонці природний порядок DOM (фото1, підпис1, фото2, підпис2…)
     сам дає правильну вертикальну послідовність. Той самий поріг
     768px, що й скрізь на сайті. */
  @media (max-width: 768px) {
    .feed__grid {
      grid-template-columns: 1fr;
    }

    .feed__grid :global(.grid-cell__link),
    .feed__grid :global(.grid-cell__caption) {
      grid-column: 1;
      grid-row: auto;
    }
  }

  .feed__view-all {
    display: block;
    width: min(660px, 92vw);
    margin: 0 auto var(--section-gap);
    text-align: center;
  }
</style>
