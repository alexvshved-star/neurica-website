---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import HomeGridCell from '@/components/HomeGridCell.astro';
import { brandDescriptor, t, type Locale } from '@/i18n';
import { excludeArchive, selectHomeFeed, warnArtDirectionRepeats } from '@/lib/validate';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const all = (await getCollection('work')).map((e) => e.data);
const items = selectHomeFeed(excludeArchive(all));
warnArtDirectionRepeats(items, `home/${locale}`);

const workHref = locale === 'uk' ? '/work' : '/en/work';
---

<Base locale={locale} title="NEURICA" description={brandDescriptor}>
  <Nav locale={locale} />
  <main>
    <header class="hero">
      <div class="hero__content">
        <h1 class="type-display hero__wordmark">NEURICA</h1>
        <p class="hero__eyebrow">experiments</p>
        <p class="hero__descriptor">{brandDescriptor}</p>
      </div>
    </header>
    <section class="feed">
      <div class="feed__grid">
        {items.map((entry, i) => <HomeGridCell entry={entry} locale={locale} priority={i === 0} />)}
      </div>
    </section>
    <a class="feed__view-all mono" href={workHref}>{t(locale, 'work.viewAll')} →</a>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  /* Hero — третя ітерація (design-brief "hero+grid"): тільки текст,
     без фото/градієнтів/оверлею тексту на кадр. Неоновий коридор
     (рішення 033/034) прибрано разом із зображенням —
     src/assets/hero/entry.png видалено з репозиторію, entry.png
     більше не імпортується. Локап однаковий на mobile і desktop
     (це й було цілю — попередній варіант ховав/показував фон за
     брейкпойнтом, тепер брейкпойнту для hero взагалі нема).
     --type-display повертається до дефолтного токена (tokens.css) —
     вузький clamp під 45%-колонку зображення (рішення попереднього
     проходу) більше не потрібен, зображення нема. */
  .hero {
    padding: var(--section-gap) var(--grid-margin);
    text-align: center;
  }

  .hero__content {
    max-width: 900px;
    margin-inline: auto;
  }

  /* --type-display локально звужено під нову фіксовану колонку
     900px (без зображення дефолтна шкала токена, до 11rem=176px,
     переносить NEURICA на два рядки — виміряно реальним рендером,
     Range.getClientRects() на текстовому вузлі: перенос настає вже
     на 168px при 900px доступної ширини). 9.5rem=152px — стеля з
     запасом ≈40px; 9vw на 1680px дає 151.2px (менше стелі — vw
     керує), на 1440px — 129.6px. Мобільна шкала (≤768px, tokens.css
     :root) не чіпається — дефолт там уже вужчий за замовчуванням. */
  @media (min-width: 768px) {
    .hero {
      --type-display: clamp(2.75rem, 9vw, 9.5rem);
    }
  }

  .hero__wordmark {
    letter-spacing: var(--tracking-wordmark);
  }

  /* Другий рівень лок-апа — той самий рецепт, що й раніше (рішення
     032): кегль і базова лінія прив'язані до --type-display,
     масштабуються разом на будь-якому брейкпойнті. */
  .hero__eyebrow {
    margin-top: calc(var(--type-display) * 0.151);
    font-weight: var(--weight-strong);
    font-size: calc(var(--type-display) * 0.44);
    line-height: 1;
    letter-spacing: 0.26em;
    text-transform: lowercase;
  }

  .hero__descriptor {
    margin-top: var(--space-4);
    font-weight: var(--weight-lead);
    font-size: var(--type-lead);
    color: var(--color-muted);
  }

  /* Сітка 2×2 (design-brief п.2) — фіксований блок, не розтягується
     на всю ширину сторінки: min(720px, 92vw) — стеля 720px на
     широких viewport, пропорційне звуження на вузьких, той самий
     центр, що й hero__content (margin-inline:auto відносно того
     самого батька). На 1440/1680 це і є перевірка "сітка не
     розтягується": ширина лишається 720px, не 100% контейнера. */
  .feed {
    padding-bottom: var(--section-gap);
  }

  .feed__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
    width: min(720px, 92vw);
    margin-inline: auto;
  }

  /* Мобільний: один стовпчик (design-brief п.3), клітинки лишаються
     КВАДРАТНИМИ — aspect-ratio:1/1 заданий прямо на .grid-cell__cover
     (HomeGridCell.astro), не залежить від кількості колонок, тому
     той самий кроп кадру на телефоні й на десктопі. Той самий поріг
     768px, що й скрізь на сайті (tokens.css, тут — раніше .feed). */
  @media (max-width: 768px) {
    .feed__grid {
      grid-template-columns: 1fr;
    }
  }

  .feed__view-all {
    display: block;
    width: min(720px, 92vw);
    margin: 0 auto var(--section-gap);
    text-align: center;
  }
</style>
