---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import WorkCard from '@/components/WorkCard.astro';
import { brandDescriptor, type Locale } from '@/i18n';
import { excludeArchive, warnArtDirectionRepeats } from '@/lib/validate';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const all = (await getCollection('work')).map((e) => e.data);
const items = excludeArchive(all);
warnArtDirectionRepeats(items, `home/${locale}`);
---

<Base locale={locale} title="NEURICA" description={brandDescriptor}>
  <Nav locale={locale} />
  <main>
    <header class="hero">
      <h1 class="type-display">NEURICA</h1>
      <p class="hero__descriptor mono">{brandDescriptor}</p>
    </header>
    <section class="work-grid">
      {items.map((entry) => <WorkCard entry={entry} locale={locale} />)}
    </section>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  .hero {
    padding: var(--section-gap-mobile) var(--grid-margin);
  }

  .hero__descriptor {
    margin-top: var(--space-4);
    font-size: var(--type-lead);
    color: var(--color-muted);
  }

  .work-grid {
    display: grid;
    gap: var(--grid-gutter);
    padding: 0 var(--grid-margin) var(--section-gap-mobile);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
