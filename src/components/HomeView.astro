---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import WorkCard from '@/components/WorkCard.astro';
import heroImage from '@/assets/hero/entry.png';
import { brandDescriptor, t, type Locale } from '@/i18n';
import { excludeArchive, selectHomeFeed, warnArtDirectionRepeats } from '@/lib/validate';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const all = (await getCollection('work')).map((e) => e.data);
const items = selectHomeFeed(excludeArchive(all));
warnArtDirectionRepeats(items, `home/${locale}`);

const workHref = locale === 'uk' ? '/work' : '/en/work';
---

<Base locale={locale} title="NEURICA" description={brandDescriptor}>
  <Nav locale={locale} />
  <main>
    <header class="hero" data-direction="chromatic">
      <Picture
        class="hero__bg"
        src={heroImage}
        alt=""
        role="presentation"
        formats={['avif', 'webp']}
        widths={[640, 1024, 1440, 1672]}
        sizes="(max-width: 767px) 1px, 100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__content">
        <h1 class="type-display hero__wordmark">NEURICA</h1>
        <p class="hero__eyebrow">experiments</p>
        <p class="hero__descriptor">{brandDescriptor}</p>
      </div>
    </header>
    <section class="feed">
      {items.map((entry, i) => <WorkCard entry={entry} locale={locale} priority={i === 0} />)}
    </section>
    <a class="feed__view-all mono" href={workHref}>{t(locale, 'work.viewAll')} →</a>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  /* Неоновий коридор — CHROMATIC (рішення 033): --color-accent
     cyan, жодного red-акценту на цьому екрані (домінує маджента
     кадру, поруч --brand-red читається як помилка друку). .hero
     сам без явного background — фон під зображенням лишається
     сторінковим --color-bg (#101820, з :root, не chromatic-scope),
     саме до нього піднята чорна точка зображення нижче. */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(480px, 44vw, 680px);
  }

  /* Колонка тексту звужена до 45% (нижче) — той самий --type-display,
     що заповнював усю ширину сторінки, у неї не влазить (NEURICA
     переносилась на два рядки при 172.8px на 584px доступної
     ширини). Локальний, менший clamp тільки в .hero — виміряний
     реальним рендером (canvas measureText з --tracking-wordmark),
     не підібраний на око: 7.35vw дає ~106px на 1440px проти
     виміряних 584px доступної ширини колонки (з запасом). Тільки
     ≥768px, де взагалі
     є зображення й звужена колонка — на мобільному (нижче)
     повертається звичайний --type-display на повній ширині. */
  @media (min-width: 768px) {
    .hero {
      --type-display: clamp(2.25rem, 7.35vw, 6.8rem);
    }
  }

  /* :global — Picture рендерить <picture><source/><img/></picture>;
     клас лягає на сам <img>, але <picture>-обгортку теж потрібно
     розкласти на весь блок, інакше вона лишається inline. */
  .hero :global(picture) {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
  }

  .hero :global(.hero__bg) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    filter: var(--image-filter, none);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 45%;
    padding: var(--section-gap) var(--grid-margin);
  }

  /* Мобільний варіант — обране рішення 034: 16:9-кадр не влазить у
     повноширинну колонку осмислено, а кроп із затемненням до порогу
     контрасту (перевірено: 0,35 непрозорості дає 2.89:1 на
     дескрипторі — провал; 0.13 дає 4.71:1, прохід, але зображення
     тоді ледь помітне) не виправдовує крихкість — чисте
     --color-bg надійніше. Зображення взагалі не завантажується на
     цій ширині (sizes 1px вище, не lazy — просто найменший srcset-
     кандидат, елемент лишається в DOM для ≥768px). */
  @media (max-width: 767px) {
    .hero {
      min-height: 0;
    }

    .hero :global(picture) {
      display: none;
    }

    .hero__content {
      max-width: 100%;
    }
  }

  /* Wordmark — трекінг окремим токеном (--tracking-wordmark),
     джерело: подача ALTACO MONOCHROME. Компонована пара з
     .hero__eyebrow нижче, .type-display сам лишається незмінним. */
  .hero__wordmark {
    letter-spacing: var(--tracking-wordmark);
  }

  /* Другий рівень лок-апа — відлуння слова з дескриптора нижче,
     Montserrat (голос, не mono), кегль і базова лінія прив'язані до
     --type-display, тому масштабуються разом з wordmark на будь-якому
     брейкпойнті (значення виміряні реальним рендером, не абстрактно). */
  .hero__eyebrow {
    margin-top: calc(var(--type-display) * 0.151);
    font-weight: var(--weight-strong);
    font-size: calc(var(--type-display) * 0.44);
    line-height: 1;
    letter-spacing: 0.26em;
    text-transform: lowercase;
  }

  /* Дескриптор бренду — речення, не метадані: Montserrat Light, не
     mono (типографічний прохід v0.2, принцип). Не успадковує .meta. */
  .hero__descriptor {
    margin-top: var(--space-4);
    font-weight: var(--weight-lead);
    font-size: var(--type-lead);
    color: var(--color-muted);
  }

  /* Стрічка: масштаб картки (data-scale на WorkCard) виражається як
     ширина в сітці — саме те, що робить головну "живою стрічкою",
     не однорідним переліком (розділ 2/4 IA-брифу). */
  .feed {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--grid-gutter);
    padding: 0 var(--grid-margin) var(--section-gap);
  }

  .feed :global([data-scale='large']) {
    grid-column: span 2;
  }

  @media (max-width: 768px) {
    .feed {
      grid-template-columns: 1fr;
    }

    .feed :global([data-scale='large']) {
      grid-column: span 1;
    }
  }

  .feed__view-all {
    display: block;
    margin: 0 var(--grid-margin) var(--section-gap);
  }
</style>
