---
import { t, getAlternate, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pathname = Astro.url.pathname;
const home = locale === 'uk' ? '/' : '/en/';
const workHref = locale === 'uk' ? '/work' : '/en/work';
const aboutHref = locale === 'uk' ? '/about' : '/en/about';
const archiveHref = locale === 'uk' ? '/archive' : '/en/archive';
const otherLocale: Locale = locale === 'uk' ? 'en' : 'uk';
const switchHref = getAlternate(pathname, otherLocale);
---

<nav class="site-nav">
  <a class="site-nav__brand mono" href={home}>NEURICA</a>
  <ul class="site-nav__links mono">
    <li><a href={workHref}>{t(locale, 'nav.work')}</a></li>
    <li><a href={aboutHref}>{t(locale, 'nav.about')}</a></li>
    <li><a href={archiveHref}>{t(locale, 'nav.archive')}</a></li>
    <li><a href={switchHref} hreflang={otherLocale}>{otherLocale.toUpperCase()}</a></li>
  </ul>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) var(--grid-margin);
    border-bottom: var(--rule-hairline) solid var(--color-rule);
  }

  .site-nav__brand {
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-label);
    text-decoration: none;
  }

  .site-nav__links {
    display: flex;
    gap: var(--space-6);
    font-size: var(--type-mono);
    letter-spacing: var(--tracking-mono);
  }

  .site-nav__links a {
    text-decoration: none;
  }
</style>
