---
import { t, getAlternate, byEonyx, eonyxUrl, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pathname = Astro.url.pathname;
const home = locale === 'uk' ? '/' : '/en/';
const workHref = locale === 'uk' ? '/work' : '/en/work';
const aboutHref = locale === 'uk' ? '/about' : '/en/about';
const otherLocale: Locale = locale === 'uk' ? 'en' : 'uk';
const switchHref = getAlternate(pathname, otherLocale);
---

<nav class="site-nav">
  <div class="site-nav__brand-block">
    <a class="site-nav__brand" href={home}>NEURICA</a>
    <a class="site-nav__by" href={eonyxUrl}>{byEonyx}</a>
  </div>
  <ul class="site-nav__links mono">
    <li><a href={workHref}>{t(locale, 'nav.work')}</a></li>
    <li><a href={aboutHref}>{t(locale, 'nav.about')}</a></li>
  </ul>
  <a class="site-nav__lang mono" href={switchHref} hreflang={otherLocale}>{otherLocale.toUpperCase()}</a>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) var(--grid-margin);
    border-bottom: var(--rule-hairline) solid var(--color-rule);
  }

  .site-nav__brand-block {
    display: flex;
    flex-direction: column;
    line-height: var(--leading-tight);
  }

  /* Знак і підпис бренду — голос, не стан: Montserrat, не mono
     (типографічний прохід v0.2, принцип). "NEURICA" — дрібний
     акцентний заголовок (weight-strong, 700 — оптична компенсація
     на малому кеглі). "by EONYX" лишається mixed-case тегліном
     бренду, не .meta: regular, не форсовано в uppercase. */
  .site-nav__brand {
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }

  .site-nav__by {
    font-weight: var(--weight-regular);
    font-size: var(--type-metadata);
    color: var(--color-muted);
    text-decoration: none;
  }

  .site-nav__links {
    display: flex;
    gap: var(--space-6);
    font-size: var(--type-mono);
    letter-spacing: var(--tracking-mono);
  }

  .site-nav__links a,
  .site-nav__lang {
    text-decoration: none;
  }
</style>
