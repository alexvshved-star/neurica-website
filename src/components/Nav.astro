---
import { t, getAlternate, byLabel, eonyxLabel, eonyxUrl, type Locale } from '@/i18n';
import BrandMark from './BrandMark.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pathname = Astro.url.pathname;
const home = locale === 'uk' ? '/' : '/en/';
const workHref = locale === 'uk' ? '/work' : '/en/work';
const aboutHref = locale === 'uk' ? '/about' : '/en/about';
const otherLocale: Locale = locale === 'uk' ? 'en' : 'uk';
const switchHref = getAlternate(pathname, otherLocale);
---

<nav class="site-nav">
  <div class="site-nav__brand-block">
    <a class="site-nav__brand" href={home}>NEURICA</a>
    <a class="site-nav__by" href={eonyxUrl}
      >{byLabel} <BrandMark name="wordmark" class="site-nav__by-mark" /><span class="sr-only">{eonyxLabel}</span></a
    >
  </div>
  <ul class="site-nav__links mono-label">
    <li><a href={workHref}>{t(locale, 'nav.work')}</a></li>
    <li><a href={aboutHref}>{t(locale, 'nav.about')}</a></li>
  </ul>
  <a class="site-nav__lang mono-label" href={switchHref} hreflang={otherLocale}>{otherLocale.toUpperCase()}</a>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6) var(--grid-margin);
    border-bottom: var(--rule-hairline) solid var(--color-rule);
  }

  .site-nav__brand-block {
    display: flex;
    flex-direction: column;
    line-height: var(--leading-tight);
  }

  /* Знак і підпис бренду — голос, не стан: Montserrat, не mono
     (типографічний прохід v0.2, принцип). "NEURICA" — дрібний
     акцентний заголовок (weight-strong, 700 — оптична компенсація
     на малому кеглі). "by EONYX" лишається mixed-case тегліном
     бренду, не .meta: regular, не форсовано в uppercase. */
  .site-nav__brand {
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }

  .site-nav__by {
    display: inline-flex;
    align-items: center;
    gap: 0.1em;
    font-weight: var(--weight-regular);
    font-size: var(--type-metadata);
    color: var(--color-muted);
    text-decoration: none;
  }

  /* Wordmark замінює слово "EONYX" — висота прив'язана до кегля
     рядка (1em), відстань між "by" і знаком (--space між flex-items,
     тут gap) = 0.1 висоти знака (X1), правило MINIMUM INDENT FOR
     TEXT з брендбука. */
  /* :global — BrandMark інлайнить <svg> через set:html в іншому
     компоненті, скоуп-атрибут Astro на нього не потрапляє. */
  .site-nav__by :global(.site-nav__by-mark) {
    height: 1em;
    width: auto;
  }

  /* Центрування відносно РЕАЛЬНОГО вільного простору між логотипом і
     перемикачем мови, не відносно вікна (заміна рішення 050): два
     margin-left:auto (тут і на .site-nav__lang нижче) — єдині auto-
     відступи на flex-лінії, тому браузер ділить залишок вільного
     простору між ними порівну (специфікація flexbox: кілька auto-
     margin на одній лінії отримують рівні частки; це відбувається ДО
     justify-content, тому властивість на .site-nav більше не
     потрібна). На відміну від space-between (рішення 050, скасовано)
     цей спосіб не залежить від того, що лого й EN різної ширини —
     проміжок логотип→меню завжди дорівнює проміжку меню→перемикач,
     а не проміжку логотип→центр-вікна. Та сама формула на будь-якій
     ширині, без медіа-умов — на desktop блок так само стоїть по
     центру своєї смуги, не вікна. */
  .site-nav__links {
    display: flex;
    gap: var(--space-6);
    margin-left: auto;
  }

  /* Другий auto-відступ тієї самої flex-лінії — разом із
     .site-nav__links вище ділить вільний простір на дві рівні
     частки: логотип→меню і меню→перемикач. */
  .site-nav__lang {
    margin-left: auto;
  }

  .site-nav__links a,
  .site-nav__lang {
    text-decoration: none;
  }
</style>
