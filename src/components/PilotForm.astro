---
import type { Locale } from '@/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const uk = locale === 'uk';
const name = `neurica-pilot-${locale}`;
const copy = uk ? {
  title: 'Долучитися до тестування',
  intro: 'Спробуйте прототипи та пілоти EONYX на власних задачах. Розкажіть, що вас цікавить — зв’яжемося, щоб обговорити участь.',
  name: 'Ім’я', email: 'Email', company: 'Компанія / роль', phone: 'Телефон',
  optional: 'необов’язково', interest: 'Що хочете тестувати?', choose: 'Оберіть напрям',
  options: ['Каталог і документи ALTACO', 'AI-агенти та автоматизація', 'Інші прототипи Neurica', 'Ще визначаюся'],
  message: 'Ваша задача або сценарій', placeholder: 'Що хочете спробувати та в якій роботі це може допомогти?',
  note: 'Використаємо ваші контакти, щоб відповісти щодо участі. Не додавайте паролі чи конфіденційні дані. Заявка не гарантує доступу до всіх прототипів.',
  submit: 'Надіслати заявку', required: '* — обов’язкові поля',
} : {
  title: 'Join the testing',
  intro: 'Try EONYX prototypes and pilots with your own tasks. Tell us what interests you — we’ll get in touch to discuss participation.',
  name: 'Name', email: 'Email', company: 'Company / role', phone: 'Phone',
  optional: 'optional', interest: 'What would you like to test?', choose: 'Select an area',
  options: ['ALTACO catalogue and documents', 'AI agents and automation', 'Other Neurica prototypes', 'Still exploring'],
  message: 'Your task or use case', placeholder: 'What would you like to try, and how could it help your work?',
  note: 'We’ll use your contact details to reply about participation. Don’t include passwords or confidential data. Applying does not guarantee access to every prototype.',
  submit: 'Submit application', required: '* — required fields',
};
const values = ['altaco', 'agents', 'prototypes', 'exploring'];
---
<section class="pilot" aria-labelledby="pilot-title" id="pilot">
  <h2 id="pilot-title">{copy.title}</h2>
  <p class="pilot-intro">{copy.intro}</p>
  <form name={name} method="POST" action={uk ? '/about/thanks/' : '/en/about/thanks/'} data-netlify="true" netlify-honeypot="bot-field">
    <input type="hidden" name="form-name" value={name} />
    <input type="hidden" name="locale" value={locale} />
    <p hidden><label>Leave empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
    <p class="pilot-required">{copy.required}</p>
    <div class="pilot-grid">
      <label for="pilot-name">{copy.name} *<input id="pilot-name" name="name" autocomplete="name" required maxlength="120" /></label>
      <label for="pilot-email">{copy.email} *<input id="pilot-email" name="email" type="email" autocomplete="email" required maxlength="254" /></label>
      <label for="pilot-company">{copy.company} <span>({copy.optional})</span><input id="pilot-company" name="company" autocomplete="organization" maxlength="160" /></label>
      <label for="pilot-phone">{copy.phone} <span>({copy.optional})</span><input id="pilot-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
    </div>
    <label for="pilot-interest">{copy.interest} *
      <select id="pilot-interest" name="interest" required>
        <option value="" disabled selected>{copy.choose}</option>
        {copy.options.map((label, i) => <option value={values[i]}>{label}</option>)}
      </select>
    </label>
    <label for="pilot-message">{copy.message} *<textarea id="pilot-message" name="message" rows="4" required maxlength="3000" placeholder={copy.placeholder}></textarea></label>
    <p class="pilot-note">{copy.note}</p>
    <button type="submit">{copy.submit} ↗</button>
  </form>
</section>
<style>
  .pilot { border-top: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule); padding: var(--space-8) 0; }
  h2 { font-size: 1.5rem; font-weight: 600; line-height: 1.3; }
  .pilot-intro { margin-top: var(--space-4); color: var(--color-muted); font-size: .95rem; }
  form { margin-top: var(--space-6); text-align: left; display: grid; gap: var(--space-6); }
  .pilot-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--space-6); }
  label { display: block; font-size: .85rem; font-weight: 600; }
  label span { font-weight: 400; color: var(--color-muted); }
  input, select, textarea { display: block; width: 100%; min-width: 0; margin-top: 8px; padding: 12px; border: 1px solid var(--color-rule); border-radius: 0; background: var(--color-bg); color: var(--color-text); font: inherit; font-size: 16px; font-weight: 400; }
  input, select { min-height: 48px; }
  textarea { resize: vertical; min-height: 128px; }
  textarea::placeholder { color: var(--color-muted); opacity: 1; }
  input:focus-visible, select:focus-visible, textarea:focus-visible, button:focus-visible { outline: 2px solid var(--brand-cyan); outline-offset: 3px; }
  .pilot-required, .pilot-note { font-size: .8rem; color: var(--color-muted); line-height: 1.6; }
  button { min-height: 48px; padding: 14px 20px; border: 1px solid var(--brand-cyan); background: transparent; color: var(--color-text); font-family: var(--font-mono); font-size: .9rem; cursor: pointer; }
  button:hover { background: var(--brand-cyan); color: var(--brand-black); }
  @media (max-width: 600px) { .pilot-grid { grid-template-columns: minmax(0,1fr); } }
</style>
