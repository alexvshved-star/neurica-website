---
import { Picture } from 'astro:assets';
import { type Locale } from '@/i18n';
import { renderableStatus, cardScale } from '@/lib/validate';
import type { WorkEntry } from '@/content.config';

interface Props {
  entry: WorkEntry;
  locale: Locale;
  /** /work, /archive — компактний однорідний рядок, без cover і без
   * масштабної варіації (розділ 2 IA-брифу: повнота важливіша за акцент). */
  compact?: boolean;
  /** Перший екран — без lazy (§2.1 content-prep брифу). */
  priority?: boolean;
}

const { entry, locale, compact = false, priority = false } = Astro.props;
const translation = entry.translations[locale];
if (!translation) {
  throw new Error(`WorkCard: ${entry.slug} не має перекладу для ${locale} (мало впасти на 5.7 раніше)`);
}

const href = locale === 'uk' ? `/work/${entry.slug}` : `/en/work/${entry.slug}`;
const status = renderableStatus(entry.status);
const statusClass = entry.status === 'LIVE'
  ? 'meta--live'
  : entry.status === 'FROZEN' || entry.status === 'ARCHIVE'
    ? 'meta--frozen'
    : 'meta--status';

const scale = cardScale(entry);
---

<a
  class="work-card"
  class:list={{ 'work-card--compact': compact }}
  href={href}
  data-direction={entry.art_direction.toLowerCase()}
  data-scale={compact ? undefined : scale}
>
  {!compact && (
    <Picture
      class="work-card__cover"
      src={entry.cover}
      alt=""
      formats={['avif', 'webp']}
      widths={[400, 800, 1200]}
      sizes="(min-width: 768px) 50vw, 100vw"
      loading={priority ? 'eager' : 'lazy'}
    />
  )}
  <div class="work-card__body">
    <p class="meta work-card__type">
      {entry.type.replace('_', ' ')}{status && <span class={`meta ${statusClass}`}> · {status}</span>}
    </p>
    <h2 class="work-card__title">{translation.title}</h2>
    <p class="work-card__summary mono">{translation.summary}</p>
  </div>
</a>

<style>
  .work-card {
    display: block;
    padding: var(--card-density, var(--space-8));
    border: var(--card-border, var(--rule-hairline) solid var(--color-rule));
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
  }

  .work-card--compact {
    padding: var(--space-4);
  }

  .work-card :global(.work-card__cover) {
    display: block;
    margin-bottom: var(--space-4);
    aspect-ratio: var(--image-ratio, 16 / 9);
    width: 100%;
    height: auto;
    object-fit: cover;
    filter: var(--image-filter, none);
  }

  .work-card__type {
    margin-bottom: var(--space-2);
  }

  .work-card--compact .work-card__type {
    margin-bottom: var(--space-1);
  }

  .work-card__title {
    font-family: var(--font-display);
    font-weight: var(--weight-strong);
    font-size: var(--type-h2);
    line-height: var(--leading-heading);
    margin-bottom: var(--space-3);
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .work-card--compact .work-card__title {
    font-size: var(--type-lead);
    margin-bottom: 0;
  }

  .work-card__summary {
    font-size: var(--type-mono);
    color: var(--color-muted);
  }

  .work-card--compact .work-card__summary {
    display: none;
  }
</style>
