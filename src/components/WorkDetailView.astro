---
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import BrandMark, { type BrandMarkName } from '@/components/BrandMark.astro';
import CaseTemplate from '@/components/work-templates/CaseTemplate.astro';
import PrototypeTemplate from '@/components/work-templates/PrototypeTemplate.astro';
import VisualStudyTemplate from '@/components/work-templates/VisualStudyTemplate.astro';
import EditorialTemplate from '@/components/work-templates/EditorialTemplate.astro';
import { t, type Locale } from '@/i18n';
import { renderableStatus } from '@/lib/validate';
import type { WorkEntry } from '@/content.config';

interface Props {
  entry: WorkEntry;
  locale: Locale;
  prevEntry: WorkEntry | null;
  nextEntry: WorkEntry | null;
}

const { entry, locale, prevEntry, nextEntry } = Astro.props;
const translation = entry.translations[locale];
if (!translation) {
  throw new Error(`WorkDetailView: ${entry.slug} не має перекладу для ${locale}`);
}

const status = renderableStatus(entry.status);
const metaLine = [entry.type.replace('_', ' '), status, String(entry.year)].filter(Boolean);

// Мінімальний рендер body: абзаци, розділені порожнім рядком.
// Повноцінний markdown-рендеринг — поза межами каркасу.
const body = translation.body ? translation.body.split(/\n\s*\n/) : [];

// EDITORIAL не показує cover у тілі — обкладинка вже відпрацювала
// як картка в стрічці й у og:image (розділ 3.5 IA-брифу).
const showCover = entry.type !== 'EDITORIAL';

// Центрування — наскрізне для всієї прози сайту (docs/02-design-system.md,
// «Центрування»): усі типи об'єкта центруються однаково, /work і
// /archive (переліки карток, не проза) не зачіпаються. Header і
// pager центруються тут, кожен шаблон центрує власний вміст сам.

// Формула зі стрілками лишається mono/ліворуч завжди — центрований
// моноширинний рядок читається як зламаний код (розділ 3 брифу
// центрування). Звичайне речення в summary йде за правилом шаблону.
const isFormulaSummary = translation.summary.includes('→');
const isAgentWorkflow = entry.slug === 'agent-workflow';

// Знак контексту — мапа context → BrandMark, не хардком під ALTACO:
// додати EONYX пізніше означає додати рядок сюди, не правити шаблон.
// EXTERNAL/INTERNAL без знака — чужого бренду для показу нема
// (docs/02-design-system.md, «Чужі знаки»).
const CONTEXT_MARKS: Partial<Record<NonNullable<WorkEntry['context']>, BrandMarkName>> = {
  ALTACO: 'altaco-wordmark',
};
const contextMark = entry.context ? CONTEXT_MARKS[entry.context] : undefined;

const workHref = locale === 'uk' ? '/work' : '/en/work';
const slugHref = (slug: string) => (locale === 'uk' ? `/work/${slug}` : `/en/work/${slug}`);
---

<Base
  locale={locale}
  title={translation.title}
  description={translation.summary}
  image={entry.cover}
  ogType="article"
>
  <Nav locale={locale} />
  <main data-direction={entry.art_direction.toLowerCase()}>
    <header class:list={["work-detail__header", { "work-detail__header--agent-workflow": isAgentWorkflow }]}>
      <p class="meta">
        {metaLine[0]}
        {metaLine.slice(1).map((part) => <span class="meta meta--status"> · {part}</span>)}
      </p>
      {contextMark && (
        <p class="work-detail__context">
          <BrandMark name={contextMark} class="work-detail__context-mark" />
          <span class="sr-only">{entry.context}</span>
        </p>
      )}
      <h1 class:list={{ "mono-label": isAgentWorkflow }}>{translation.title}</h1>
      <p class={`work-detail__summary${isFormulaSummary ? ' mono work-detail__summary--formula' : ''}`}>
        {translation.summary}
      </p>
      {translation.tags && translation.tags.length > 0 && (
        <ul class="work-detail__tags mono">
          {translation.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>

    {showCover && (
      <Picture
        class="work-detail__cover"
        src={entry.cover}
        alt=""
        formats={['avif', 'webp']}
        widths={[600, 1200, 1800]}
        sizes="(min-width: 1200px) 1200px, 100vw"
        loading="eager"
      />
    )}

    <div class="work-detail__body">
      {entry.type === 'CASE' && <CaseTemplate entry={entry} locale={locale} body={body} />}
      {(entry.type === 'PROTOTYPE' || entry.type === 'TOOL' || entry.type === 'EXPERIMENT') && (
        <PrototypeTemplate entry={entry} locale={locale} body={body} />
      )}
      {entry.type === 'VISUAL_STUDY' && <VisualStudyTemplate entry={entry} locale={locale} body={body} />}
      {entry.type === 'EDITORIAL' && <EditorialTemplate body={body} />}
    </div>

    <nav class="work-detail__pager mono" aria-label="pagination">
      {prevEntry && (
        <a href={slugHref(prevEntry.slug)}>
          ← {t(locale, 'work.prev')}: {prevEntry.translations[locale]?.title}
        </a>
      )}
      {nextEntry && (
        <a href={slugHref(nextEntry.slug)}>
          {t(locale, 'work.next')}: {nextEntry.translations[locale]?.title} →
        </a>
      )}
      <a href={workHref}>{t(locale, 'work.backToWork')}</a>
    </nav>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  main {
    padding: var(--section-gap) var(--grid-margin);
  }

  main > * + * {
    margin-top: var(--space-6);
  }

  /* Центрування — наскрізне для всієї прози сайту, одна вісь на всю
     сторінку: header звужується до тієї самої міри, що й центрований
     блок контенту (560px, локальне значення шаблонів, не
     --width-reading — той токен лишається джерелом істини, просто
     без активних споживачів на цьому кроці), і отримує
     margin-inline: auto — інакше текст центрується всередині лівого
     стовпця, а не сторінки. Cover не чіпається — розкладка зображень
     поза межами правила центрування. */
  .work-detail__header {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .work-detail__header > * + * {
    margin-top: var(--space-3);
  }

  .work-detail__summary {
    color: var(--color-muted);
  }

  /* Знак контексту — позначка, не заголовок: висота = висота рядка
     метаданих (--type-metadata), а не окремий вибраний розмір. При
     10.87:1 це дає ширину ≈120px на десктопі (виміряно: 0.6875rem
     × 10.87 ≈ 119.6px). currentColor — успадковує --color-muted,
     контраст проти всіх чотирьох art_direction — той самий токен,
     що вже використовує .work-detail__summary/.work-detail__tags
     на цих самих фонах. */
  .work-detail__context {
    font-size: var(--type-metadata);
    color: var(--color-muted);
  }

  /* :global — BrandMark інлайнить <svg> через set:html в іншому
     компоненті, скоуп-атрибут Astro на нього не потрапляє. */
  .work-detail__context :global(.work-detail__context-mark) {
    display: inline-block;
    height: 1em;
    width: auto;
    vertical-align: middle;
  }

  .work-detail__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    color: var(--color-muted);
  }

  /* Плита на всю ширину контейнера (крок design-brief §2.2) — раніше
     max-width: var(--width-content) (1200px) лишало порожній navy
     праворуч, коли main ширший (без width:100% картинка трималась
     власної натуральної ширини). aspect-ratio + object-fit:cover —
     той самий рецепт, що й у WorkCard.astro для карток стрічки:
     кроп без літербоксингу, порожньої поверхні всередині рамки
     кадру нема. */
  main :global(.work-detail__cover) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--image-ratio, 16 / 9);
    object-fit: cover;
  }

  .work-detail__pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: var(--rule-hairline) solid var(--color-rule);
    text-align: center;
  }

  /* Формула зі стрілками — завжди ліворуч, навіть на центрованій
     сторінці: mono означає машинну інформацію, а її вирівнюють
     ліворуч (docs/02-design-system.md, «Центрування» → «Формули
     ніколи не центруються»). Звичайне речення в summary не отримує
     ні .mono, ні цього класу — йде за правилом шаблону. */
  .work-detail__summary--formula {
    text-align: left;
  }
  /* Agent workflow: user-requested navigation typography, with the
     existing heading size retained. Its formula is centred as an
     explicit exception to the default left-aligned formula style. */
  .work-detail__header--agent-workflow h1 {
    font-size: var(--type-h1);
  }

  .work-detail__header--agent-workflow .work-detail__summary {
    text-align: center;
  }
</style>
