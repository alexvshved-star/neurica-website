---
import {Picture} from 'astro:assets';
import {photoFor,productHref,money} from '@/catalog/data';
import {labels,materialLabel} from '@/catalog/labels';
import type {Product,Locale} from '@/catalog/types';
interface Props {product:Product;locale:Locale;index:number}
const {product:p,locale,index}=Astro.props;const l=labels(locale);const photo=photoFor(p.photo);
---
<li class="catalog-card" data-product-id={p.id}>
 <a href={productHref(locale,p.id)} aria-label={`${p.name} · ${p.finish} · ${p.lengthMm} × ${p.widthMm} × ${p.thicknessMm} ${l.mm}`}>
  <div class="catalog-card__photo">
   {photo ? <Picture src={photo} alt={p.name} formats={['avif','webp']} widths={[300,600,1200]} sizes="(min-width: 1264px) 384px, (min-width: 900px) calc((100vw - 112px) / 3), calc((100vw - 48px) / 2)" loading={index<2?'eager':'lazy'} /> : <span class="mono">{l.noPhoto}</span>}
  </div>
  <p class="catalog-card__type mono">{materialLabel(p.materialType,locale)}</p>
  <h2 class="mono-label">{p.name}</h2>
  <p class="catalog-card__variant mono">{p.finishPending?l.surfacePending:p.finish} · {p.thicknessMm} {l.mm}</p>
  <p class="catalog-card__format mono">{p.lengthMm} × {p.widthMm} {l.mm}</p>
  <div class="catalog-card__price"><span>{money(p.priceM2Cents,locale)} {p.priceM2Cents!==null&&<small>{l.perM2}</small>}</span><span aria-hidden="true">↗</span></div>
  <p class:list={['catalog-card__stock','mono',{'is-available':p.inStock}]}>{p.inStock?l.inStock:l.outOfStock}</p>
  {p.kind!=='slab'&&<p class="catalog-card__kind mono">{p.kind==='sample-slab'?l.sample:l.fragment}</p>}
 </a>
</li>
<style>
.catalog-card{min-width:0}.catalog-card a{display:block;text-decoration:none;height:100%}.catalog-card a:focus-visible{outline:2px solid var(--brand-cyan);outline-offset:5px}
.catalog-card__photo{position:relative;aspect-ratio:1;overflow:hidden;background:rgba(255,255,255,.035);display:grid;place-items:center;color:var(--color-muted);text-align:center}
.catalog-card__photo :global(picture){position:absolute;inset:0;display:block}.catalog-card__photo :global(source){display:none}.catalog-card__photo :global(img){width:100%;height:100%;object-fit:cover;transition:transform .2s}.catalog-card a:hover :global(img){transform:scale(1.025)}
.catalog-card__type{color:var(--color-muted);font-size:11px;margin-top:16px}.catalog-card h2{color:var(--color-text);font-size:14px;line-height:1.5;letter-spacing:.04em;margin:4px 0;hyphens:none;overflow-wrap:anywhere}
.catalog-card__variant,.catalog-card__format,.catalog-card__stock,.catalog-card__kind{font-size:11px;color:var(--color-muted)}
.catalog-card__price{border-top:1px solid var(--color-rule);margin-top:12px;padding-top:12px;display:flex;justify-content:space-between;gap:8px;font-size:16px;font-weight:600}.catalog-card__price small{font-weight:400;color:var(--color-muted);font-size:11px}
.catalog-card__stock{margin-top:8px}.is-available{color:var(--brand-cyan)}.catalog-card__kind{margin-top:4px}
@media(max-width:480px){.catalog-card h2{font-size:12px}.catalog-card__price{font-size:14px}.catalog-card__type,.catalog-card__variant,.catalog-card__format,.catalog-card__stock{font-size:10px}}
@media(prefers-reduced-motion:reduce){.catalog-card__photo :global(img){transition:none}}
</style>
