---
import {Picture} from 'astro:assets';
import {products,money,photoFor,productHref} from '@/catalog/data';
import {labels} from '@/catalog/labels';
import type {Locale} from '@/catalog/types';
interface Props {locale:Locale}
const {locale}=Astro.props;const uk=locale==='uk';const l=labels(locale);
---
<div class="cart-toolbar" data-cart-toolbar hidden>
 <button type="button" data-open-cart aria-haspopup="dialog" aria-controls="altaco-cart">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 3h3l3 12h11l3-9H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
  {uk?'Кошик':'Cart'} <span data-cart-count>0</span>
 </button>
 <span class="cart-feedback" data-cart-feedback role="status" aria-live="polite"></span>
</div>
<dialog id="altaco-cart" class="cart" data-cart data-locale={locale} aria-labelledby="cart-title">
 <header class="cart-header"><h2 id="cart-title">{uk?'Кошик':'Cart'}</h2><button type="button" data-close-cart aria-label={uk?'Закрити кошик':'Close cart'} autofocus>✕</button></header>
 <div class="cart-body">
  <p class="cart-note" data-cart-storage>{uk?'Кошик зберігається в цьому браузері. Ціни з ПДВ; наявність і умови підтверджує менеджер.':'Your cart is saved in this browser. Prices include VAT; a manager confirms availability and terms.'}</p>
  <p data-cart-empty>{uk?'Кошик порожній. Додайте матеріали з каталогу.':'Your cart is empty. Add materials from the catalogue.'}</p>
  <ul data-cart-list>
  {products.filter(p=>p.kind!=='sample-slab').map(p=>{const photo=photoFor(p.photo);return <li data-cart-id={p.id} hidden>
   <div class="cart-item-info">
    {photo&&<Picture src={photo} alt="" widths={[120]} formats={['webp']} sizes="64px" loading="lazy"/>}
    <div><a href={productHref(locale,p.id)}><strong>{p.name}</strong></a><p>{p.lengthMm} × {p.widthMm} × {p.thicknessMm} {l.mm} · {p.finishPending?l.surfacePending:p.finish}</p><p>{p.inStock?l.inStock:l.outOfStock}</p><p>{p.kind==='fragment'?(uk?'Фрагмент: розрахунок за запитом':'Fragment: estimate on request'):`${money(p.priceSlabCents,locale)} / ${uk?'сляб':'slab'}`}</p><p class="cart-warning" data-cart-warning hidden></p></div>
   </div>
   <div class="cart-item-actions">
    {p.kind==='slab'&&<label>{uk?'Слябів':'Slabs'}<input data-quantity required type="number" min="1" max="999" step="1" value="1" aria-label={`${uk?'Кількість слябів':'Slab quantity'}: ${p.name}, ${p.lengthMm} × ${p.widthMm}`} /></label>}
    <span data-line-total></span>
    <button type="button" data-remove={p.id} aria-label={`${uk?'Прибрати':'Remove'} ${p.name}`}>{uk?'Прибрати':'Remove'}</button>
   </div>
  </li>})}
  </ul>
  <div data-cart-summary hidden>
   <p class="cart-total" data-cart-total role="status" aria-live="polite" aria-atomic="true"></p>
   <p class="cart-note">{uk?'PDF-КП: до 20 позицій. Лише цілі сляби в наявності з підтвердженими ціною, обробкою та фото. Без знижок.':'PDF offer: up to 20 items. Whole slabs in stock with confirmed prices, finish and photos. No discounts.'}</p>
   <p class="cart-warning" data-cart-blocked hidden></p>
   <button class="cart-primary" type="button" data-create-offer>{uk?'Сформувати КП в PDF':'Create PDF offer'}</button>
   <p data-offer-status role="status" aria-live="polite"></p>
   <a class="cart-primary" data-offer-download hidden download="ALTACO_Commercial_Offer.pdf">{uk?'Завантажити PDF-КП':'Download PDF offer'}</a>
   <button type="button" data-clear-cart>{uk?'Очистити кошик':'Clear cart'}</button>
  </div>
 </div>
 <footer class="cart-footer"><button type="button" data-close-cart>{uk?'Продовжити вибір матеріалів':'Continue browsing'}</button></footer>
</dialog>
<script>
 import '@/catalog/cart-ui';
</script>
<style>
.cart-toolbar{position:sticky;top:12px;z-index:20;display:flex;justify-content:flex-end;align-items:center;gap:12px;margin:16px 0;pointer-events:none}.cart-toolbar button{pointer-events:auto;display:flex;align-items:center;gap:10px;background:var(--color-bg);color:var(--color-text);border:1px solid var(--brand-cyan);padding:12px 18px;font:inherit;min-height:48px;cursor:pointer}.cart-toolbar [data-cart-count]{background:var(--brand-cyan);color:var(--color-bg);border-radius:20px;min-width:24px;padding:2px 6px;text-align:center}.cart-feedback{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
.cart{position:fixed;inset:0;margin:auto;width:min(760px,calc(100vw - 24px));max-width:760px;height:auto;max-height:calc(100dvh - 32px);padding:0;border:1px solid var(--color-rule);background:var(--color-bg);color:var(--color-text);text-align:left;overscroll-behavior:contain}.cart[open]{display:flex;flex-direction:column}.cart::backdrop{background:rgba(0,0,0,.72)}.cart [hidden],.cart-toolbar[hidden]{display:none!important}.cart-header,.cart-footer{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;flex-shrink:0}.cart-header{border-bottom:1px solid var(--color-rule)}.cart-header h2{font-size:22px;letter-spacing:0;text-transform:none;margin:0}.cart-body{overflow-y:auto;overscroll-behavior:contain;padding:8px 24px 24px}.cart-footer{border-top:1px solid var(--color-rule)}.cart p{font-size:13px;line-height:1.5;margin:6px 0}.cart .cart-note{color:var(--color-muted);margin:12px 0}.cart ul{list-style:none;padding:0;margin:0}.cart li{padding:20px 0;border-top:1px solid var(--color-rule)}.cart-item-info{display:flex;gap:16px}.cart-item-info>div{min-width:0;flex:1}.cart-item-info a{text-decoration:none}.cart strong{font-size:15px;overflow-wrap:anywhere}.cart-item-info :global(picture){width:64px;min-width:64px;height:64px}.cart-item-info :global(img){width:64px;height:64px;object-fit:cover}.cart-item-actions{display:flex;align-items:center;gap:16px;justify-content:flex-end;margin-top:12px;flex-wrap:wrap}.cart label{display:flex;align-items:center;gap:8px;font-size:12px}.cart input{width:76px}.cart button,.cart input,.cart .cart-primary{background:var(--color-bg);color:var(--color-text);border:1px solid var(--color-rule);padding:10px 14px;min-height:44px;font:inherit;font-size:14px}.cart button{cursor:pointer}.cart button:disabled{opacity:.45;cursor:not-allowed}.cart .cart-primary{display:inline-flex;justify-content:center;background:var(--brand-cyan);border-color:var(--brand-cyan);color:var(--color-bg);text-decoration:none;font-weight:600;margin:8px 8px 8px 0}.cart .cart-total{border-top:1px solid var(--color-rule);padding-top:20px;font-size:18px;font-weight:600}.cart .cart-warning{color:#f0ba81}.cart [aria-invalid=true]{border-color:#f99}.cart :focus-visible,.cart-toolbar :focus-visible{outline:2px solid var(--brand-cyan);outline-offset:3px}
@media(max-width:480px){.cart-header,.cart-footer{padding:12px 16px}.cart-body{padding:8px 16px 16px}.cart input{font-size:16px}.cart-item-info{gap:12px}.cart-item-actions{gap:10px;justify-content:space-between}.cart-item-actions [data-line-total]{font-size:14px}.cart .cart-primary,.cart-footer button{width:100%;margin-right:0}.cart-item-info :global(picture),.cart-item-info :global(img){width:52px;min-width:52px;height:52px}.cart strong{font-size:14px}}
</style>
