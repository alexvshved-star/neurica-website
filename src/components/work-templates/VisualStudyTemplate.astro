---
// VISUAL_STUDY — послідовність зображень із media[], мінімум тексту.
// body опційний і короткий: це шаблон, де проза заважає (розділ 3.4
// IA-брифу). media[] структурне (id+src), alt/caption локалізовані
// за тим самим id (розділ 3 content-prep брифу, рішення 024).
import { Picture } from 'astro:assets';
import type { Locale } from '@/i18n';
import type { WorkEntry } from '@/content.config';

interface Props {
  entry: WorkEntry;
  locale: Locale;
  body: string[];
}

const { entry, locale, body } = Astro.props;
const media = entry.media ?? [];
const localizedMedia = entry.translations[locale]?.media ?? {};
---

<div class="visual-study-template">
  {media.length > 0 && (
    <div class="visual-study-template__sequence">
      {media.map((item, i) => {
        const meta = localizedMedia[item.id];
        return (
          <figure>
            <Picture
              src={item.src}
              alt={meta?.alt ?? ''}
              formats={['avif', 'webp']}
              widths={[600, 1200, 1800]}
              sizes="(max-width: 768px) 92vw, (min-width: 2143px) 900px, (min-width: 1429px) 42vw, 600px"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
            {meta?.caption && <figcaption class="small">{meta.caption}</figcaption>}
          </figure>
        );
      })}
    </div>
  )}
  {body.length > 0 && (
    <p class="visual-study-template__note">{body[0]}</p>
  )}
</div>

<style>
  .visual-study-template__sequence {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Match the first cover on desktop and mobile. */
  .visual-study-template__sequence figure {
    width: 100%;
    max-width: clamp(600px, 42vw, 900px);
    margin-inline: auto;
  }

  @media (max-width: 768px) {
    .visual-study-template__sequence figure {
      max-width: min(calc(280px * 2 + 20px), 92vw);
    }
  }

  .visual-study-template__sequence :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center;
  }

  /* Підпис центрується на тій самій осі, що й зображення. */
  .visual-study-template__sequence figcaption {
    margin-top: var(--space-2);
    color: var(--color-muted);
    text-align: center;
  }

  .visual-study-template__note {
    margin-top: var(--space-6);
    max-width: var(--width-reading);
    color: var(--color-muted);
  }
</style>
