---
import { getAlternate, type Locale } from '@/i18n';
import '@/styles/tokens.css';
import '@/styles/base.css';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
}

const { locale, title, description } = Astro.props;

const pathname = Astro.url.pathname;
const ukPath = getAlternate(pathname, 'uk');
const enPath = getAlternate(pathname, 'en');
const canonicalOrigin = 'https://neurica.net';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <link rel="canonical" href={`${canonicalOrigin}${pathname}`} />
    <link rel="alternate" hreflang="uk" href={`${canonicalOrigin}${ukPath}`} />
    <link rel="alternate" hreflang="en" href={`${canonicalOrigin}${enPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${canonicalOrigin}${ukPath}`} />

    <meta property="og:locale" content={locale === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'uk' ? 'en_US' : 'uk_UA'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;700;900&subset=cyrillic,cyrillic-ext,latin&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
