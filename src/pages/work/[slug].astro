---
import { getCollection } from 'astro:content';
import WorkDetailView from '@/components/WorkDetailView.astro';
import { sortByPublishedDesc } from '@/lib/validate';

export async function getStaticPaths() {
  const entries = sortByPublishedDesc((await getCollection('work')).map((e) => e.data));
  return entries.map((entry, i) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prevEntry: entries[i - 1] ?? null,
      nextEntry: entries[i + 1] ?? null,
    },
  }));
}

const { entry, prevEntry, nextEntry } = Astro.props;
---

<WorkDetailView entry={entry} locale="uk" prevEntry={prevEntry} nextEntry={nextEntry} />
